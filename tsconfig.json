{
  "include": [
    "src/**/*",
    "@types/**/*"
  ],
  "compilerOptions": {
    "lib": ["DOM","ES2015"],
    "target":"ES2015",
    "module":"ESNext",
    "moduleResolution": "Bundler",
    "types": [],

    "sourceMap": true,

    "declaration": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false
  }
}
